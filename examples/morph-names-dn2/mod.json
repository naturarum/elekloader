{
 "id": "morph-names",
 "version": "0.1",
 "title": "Morph reverb names (EEEM)",
 "category": "Examples",
 "license": "GPL-2.0-or-later",
 "author": "naturarum",
 "description": "EXPERIMENT: emulator-tested only. For dn2-cfw's EEEM build, whose DSP runs MRB, a morphing reverb (room through hall to spring on one knob), in the reverb slot: the reverb page reads PRE DEC CHAR SIZE / VOL HPF TONE. C (was FREQ) is CHAR (\"Character\"), room at 0, hall in the middle, spring at 127; D (was GAIN) is SIZE; F (was LPF) is TONE. C and D are drawn as knobs instead of the stock shelf picture; DEC shows a plain number (no INF); a new kit starts at PRE 0, DEC 64, CHAR 64, SIZE 64, HPF 0, TONE 70. The title stays Reverb. Every knob keeps its MIDI CC, storage and DSP frame word; old kits keep their values. On a stock DSP the names would be wrong.",
 "device": "digitone-mk2",
 "os": "1.12",
 "sources": [
  "morph_names.c"
 ],
