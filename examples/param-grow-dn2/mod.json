{
 "id": "param-grow",
 "version": "0.1",
 "title": "Room for more parameter rows (GT00)",
 "category": "Examples",
 "license": "GPL-2.0-or-later",
 "author": "naturarum",
 "description": "EXPERIMENT: emulator-tested only, never run on a unit. Gives the parameter table room for 63 more rows (0x141 -> 0x180) and adds none: the table is copied to RAM at boot, before any of the OS's own code, and every instruction that holds its address or its row count is pointed at the copy; the MIDI CC/NRPN input cache and the display table follow the new count. The rows after the stock ones are copies of row 0, which is what the stock OS reads for any row id it clamps, so nothing on the screen, in MIDI or in a saved project changes. Other mods add rows through the table param_rows (grow.s says how). For dn2-cfw's GT00 build.",
 "device": "digitone-mk2",
 "os": "1.12",
 "sources": [
  "grow.s"
 ],
 "collections": {
  "param_rows": 4
 },
 "exports": [
  "pg_desc",
  "pg_xdisp",
  "pg_xdisp_on"
 ],
