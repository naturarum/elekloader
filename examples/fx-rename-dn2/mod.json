{
 "id": "fx-rename",
 "version": "0.1",
 "title": "Flanger and tape names (FTN1)",
 "category": "Examples",
 "license": "GPL-2.0-or-later",
 "author": "naturarum",
 "description": "EXPERIMENT: emulator-tested only, never run on a unit. For dn2-cfw's FTN1 build, whose DSP runs a flanger in the chorus slot and a tape delay in the delay slot: renames the chorus page and every chorus send to Flanger/FLG, and the delay page and every delay send to Tape/TAPE (the page box says TAP). Labels only: no new rows, knobs or glyphs, and every knob keeps its MIDI CC, storage and DSP frame word. On a stock DSP the names would be wrong.",
 "device": "digitone-mk2",
 "os": "1.12",
